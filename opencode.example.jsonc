{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "<your-context7-api-key>"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.78", "--browser", "chrome", "--headless"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "npm run test:all": "allow",
      "npx vitest *": "allow",
      "npx expo start*": "allow",
      "*": "ask"
    }
  }
}